# 此文件只描述 OpenShift 入口，不保存数据库、模型或对象存储密钥。
# 复制为 profile.local.env 后再填写；*.local.env 已被 .gitignore 忽略。

NAMESPACE=jiuwenswarm
ROUTE_NAME=jiuwenswarm-web
ROUTE_HOST=swarm.apps.example.com
WEB_SERVICE=jiuwenclaw-web
WEB_SERVICE_PORT=http

# 当前 Web 镜像只提供 HTTP，推荐在 OpenShift Router 使用 edge TLS termination。
TLS_TERMINATION=edge
INSECURE_EDGE_POLICY=Redirect

# REST/SSE 与 WebSocket 长任务超时。
ROUTE_TIMEOUT=1h
ROUTE_TUNNEL_TIMEOUT=1h

# restricted：删除 JiuwenBox 特权 sidecar，兼容 restricted-v2，但沙箱工具不可用。
# privileged：保留 sidecar；需要安全团队审批专用 ServiceAccount/SCC，Profile 不自动授权。
JIUWENBOX_MODE=restricted
